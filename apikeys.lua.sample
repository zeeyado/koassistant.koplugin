-- Sample API keys file
-- Rename this file to apikeys.lua and replace the placeholders with your actual API keys
--
-- This is one of three user-configurable files:
-- 1. apikeys.lua - API credentials for AI providers (this file)
-- 2. custom_actions.lua - User-defined actions
-- 3. configuration.lua - Advanced settings and provider overrides
--
-- OPTIONAL: You can store MORE THAN ONE key for the same provider.
-- Example: you have a free Gemini key and a paid one, and want to switch
-- between them without editing files each time.
--
-- To do that, write a list of entries instead of a single key. Give each
-- entry the key and a short name of your choosing (the name is just a
-- label, so the app can say "free" or "paid" instead of showing an
-- unreadable key):
--
--     gemini = {
--         { key = "KEY1",  alias = "free" },
--         { key = "KEY2", alias = "paid" },
--     },
--
-- The plugin uses the first key in the list unless you pick another one.
-- To see all your keys and pick which one is used, open:
--     Settings > API Keys > (tap the provider)
-- Keys entered inside the app take priority over keys from this file.
--
-- If you only have one key per provider, ignore all of this: keep writing
-- it the simple way shown below, nothing changes for you.

return {
    -- Anthropic API key (Claude models)
    -- Get from: https://console.anthropic.com/
    anthropic = "YOUR_ANTHROPIC_API_KEY",
    
    -- OpenAI API key (GPT models)
    -- Get from: https://platform.openai.com/
    openai = "YOUR_OPENAI_API_KEY",
    
    -- DeepSeek API key
    -- Get from: https://platform.deepseek.com/
    deepseek = "YOUR_DEEPSEEK_API_KEY",
    
    -- Google Gemini API key
    -- Get from: https://aistudio.google.com/
    gemini = "YOUR_GEMINI_API_KEY",
    
    -- Ollama typically doesn't need an API key if running locally
    -- If using a remote Ollama instance, you can set a key here if required
    ollama = "",

    -- Groq API key (fast inference)
    -- Get from: https://console.groq.com/
    groq = "YOUR_GROQ_API_KEY",

    -- Mistral AI API key
    -- Get from: https://console.mistral.ai/
    mistral = "YOUR_MISTRAL_API_KEY",

    -- xAI API key (Grok models)
    -- Get from: https://console.x.ai/
    xai = "YOUR_XAI_API_KEY",

    -- OpenRouter API key (access 500+ models)
    -- Get from: https://openrouter.ai/
    openrouter = "YOUR_OPENROUTER_API_KEY",

    -- Requesty API key (OpenAI-compatible model router)
    -- Get from: https://app.requesty.ai/api-keys
    requesty = "YOUR_REQUESTY_API_KEY",

    -- Qwen/DashScope API key (Alibaba)
    -- Get from: https://dashscope.console.aliyun.com/
    qwen = "YOUR_QWEN_API_KEY",

    -- Kimi/Moonshot API key
    -- Get from: https://platform.kimi.ai/ (International, the default)
    --       or: https://platform.moonshot.cn/ (China)
    -- Keys are NOT interchangeable between the two platforms — pick the
    -- matching region in Settings > Advanced > Provider Settings > Kimi Region.
    kimi = "YOUR_KIMI_API_KEY",

    -- Together AI API key
    -- Get from: https://api.together.xyz/
    together = "YOUR_TOGETHER_API_KEY",

    -- Fireworks AI API key
    -- Get from: https://fireworks.ai/
    fireworks = "YOUR_FIREWORKS_API_KEY",

    -- SambaNova API key
    -- Get from: https://cloud.sambanova.ai/
    sambanova = "YOUR_SAMBANOVA_API_KEY",

    -- Cohere API key
    -- Get from: https://dashboard.cohere.com/
    cohere = "YOUR_COHERE_API_KEY",

    -- Doubao/ByteDance API key
    -- Get from: https://console.volcengine.com/
    doubao = "YOUR_DOUBAO_API_KEY",

    -- Z.AI API key (GLM models, free tier available)
    -- Get from: https://z.ai/manage-apikey/apikey-list
    zai = "YOUR_ZAI_API_KEY",

    -- Perplexity API key (Sonar models, web search built-in)
    -- Get from: https://www.perplexity.ai/settings/api
    perplexity = "YOUR_PERPLEXITY_API_KEY",

    ----------------------------------------------------------------------
    -- Community set (docs-based providers — see README "Supported Providers")
    ----------------------------------------------------------------------

    -- Cerebras (very fast open-model inference)
    -- Get from: https://cloud.cerebras.ai/
    cerebras = "YOUR_CEREBRAS_API_KEY",

    -- MiniMax (M-series models)
    -- Get from: https://platform.minimax.io/
    minimax = "YOUR_MINIMAX_API_KEY",

    -- DeepInfra (open-model host)
    -- Get from: https://deepinfra.com/dash/api_keys
    deepinfra = "YOUR_DEEPINFRA_API_KEY",

    -- Novita AI (open-model host)
    -- Get from: https://novita.ai/
    novita = "YOUR_NOVITA_API_KEY",

    -- Hyperbolic (open-model host)
    -- Get from: https://app.hyperbolic.xyz/
    hyperbolic = "YOUR_HYPERBOLIC_API_KEY",

    -- NVIDIA (build.nvidia.com / NIM) -- GENEROUS FREE TIER: joining the free
    -- NVIDIA Developer Program takes an email only (no credit card, no identity
    -- check) and grants ~1000 inference credits, up to 5000 on request.
    -- Get from: https://build.nvidia.com/ -> profile menu -> Settings -> API Keys
    -- (the key looks like "nvapi-...")
    nvidia = "YOUR_NVIDIA_API_KEY",

    -- Nebius AI Studio (open-model host)
    -- Get from: https://studio.nebius.com/
    nebius = "YOUR_NEBIUS_API_KEY",

    -- Chutes (decentralized GPU marketplace)
    -- Get from: https://chutes.ai/
    chutes = "YOUR_CHUTES_API_KEY",

    -- Featherless (large open-model catalog)
    -- Get from: https://featherless.ai/
    featherless = "YOUR_FEATHERLESS_API_KEY",

    -- Vercel AI Gateway (200+ models behind one key)
    -- Get from: https://vercel.com/
    vercel = "YOUR_VERCEL_API_KEY",
}
