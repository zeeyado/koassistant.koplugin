#: koassistant/ui/settings_schema.lua:2412
#, fuzzy
msgid "Show Add to Notebook button"
msgstr "แสดงปุ่มเพิ่มลงในสมุดบันทึก"

#: koassistant/ui/settings_schema.lua:2417
#, fuzzy
