#: koassistant/ui/settings_schema.lua:3203
#, fuzzy
msgid ""
"Add a short slice of the text around the selection, marked as context only, so the illustration reflects the scene the passage sits in."
msgstr "เพิ่มข้อความส่วนสั้นๆ รอบๆ ส่วนที่เลือก โดยระบุว่าเป็นบริบทเท่านั้น เพื่อให้ภาพประกอบสะท้อนถึงฉากที่ข้อความนั้นอยู่"

#: koassistant/ui/settings_schema.lua:3208
#, fuzzy
msgid "Prompt template…"
msgstr "เทมเพลตคำสั่ง..."

#: koassistant/ui/settings_schema.lua:3211
#, fuzzy
