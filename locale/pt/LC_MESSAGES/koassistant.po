#: prompts/actions.lua:2495
#, fuzzy
msgid ""
"A brief, one-line dictionary definition of the selected word in your dictionary language."
msgstr "Uma breve definição de dicionário de uma linha da palavra selecionada no idioma do seu dicionário."

#: prompts/actions.lua:2528
#, fuzzy
msgid ""
