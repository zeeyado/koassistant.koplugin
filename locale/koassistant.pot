#: koassistant_settings_schema.lua:186
msgid "Render Math Formulas"
msgstr ""

#: koassistant_settings_schema.lua:193
msgid ""
"Show LaTeX math from responses as readable formulas: Greek letters, "
"operators, superscripts, vectors, fractions as a/b. Markdown view only. "
"Saved chats, copies and exports keep the original notation, which Obsidian "
"and similar apps render fully."
msgstr ""

#: koassistant_settings_schema.lua:198
msgid "Latest Reply on New Page"
msgstr ""

#: koassistant_settings_schema.lua:201
msgid ""
"Present the newest reply from the top of a fresh page. Markdown chats get a "
"real page break before it (older exchanges stay compact — the break moves "
"forward with each reply and never touches saves or exports); Plain Text "
"chats align the view so the reply starts the screen. Chat viewer only."
msgstr ""

#: koassistant_settings_schema.lua:206
msgid "Open Chats at Latest Exchange"
msgstr ""

#: koassistant_settings_schema.lua:209
msgid ""
"When opening a saved chat, jump to the newest question and reply instead of "
"the top. Replies always land on the newest exchange regardless of this "
"setting. Independent of New Page per Exchange (that one changes the page "
"layout; this one changes where an opened chat starts)."
msgstr ""

#: koassistant_settings_schema.lua:214
msgid "Plain Text Options"
msgstr ""

#: koassistant_settings_schema.lua:220
msgid "Apply Markdown Stripping"
msgstr ""

#: koassistant_settings_schema.lua:223
msgid ""
"Convert markdown syntax to readable plain text (headers, lists, etc). "
"Disable to show raw markdown."
msgstr ""

#: koassistant_settings_schema.lua:230
msgid "Text Mode for Dictionary"
msgstr ""

#: koassistant_settings_schema.lua:233
msgid ""
"Use Plain Text mode for dictionary popup. Better font support for non-Latin "
"scripts."
msgstr ""

#: koassistant_settings_schema.lua:238
msgid "Text Mode for RTL Dictionary"
msgstr ""

#: koassistant_settings_schema.lua:245
msgid ""
"Use Plain Text mode for dictionary popup when dictionary language is Arabic, "
"Persian, or Urdu. Grayed out when Text Mode for Dictionary is enabled."
msgstr ""

#: koassistant_settings_schema.lua:250
msgid "Text Mode for RTL Translate"
msgstr ""

#: koassistant_settings_schema.lua:253
msgid ""
"Use Plain Text mode for translate popup when translation language is Arabic, "
"Persian, or Urdu."
msgstr ""

#: koassistant_settings_schema.lua:265
msgid ""
"Automatically detect RTL content and switch to RTL mode (right-aligned text "
"+ Plain Text). Activates when the latest response has more RTL than Latin "
"characters. Disabling removes all automatic RTL adjustments. Grayed out when "
"markdown is disabled."
msgstr ""

#: koassistant_settings_schema.lua:272
msgid "Emoji"
msgstr ""

#: koassistant_settings_schema.lua:277
msgid "Emoji Menu Icons"
msgstr ""

#: koassistant_settings_schema.lua:280
msgid ""
"Show emoji icons (🔍, 📖) in UI buttons and status indicators. Requires "
"emoji font support in KOReader. Does not work on all devices. If icons "
"appear as question marks, disable this option."
msgstr ""

#: koassistant_settings_schema.lua:285
msgid "Emoji Panel Icons"
msgstr ""

#: koassistant_settings_schema.lua:288
msgid ""
"Show emoji icons on Quick Settings and Quick Actions panel buttons (🔗 "
"Provider, 🎭 Behavior, 📜 Chat History, etc.). Requires emoji font support."
msgstr ""

#: koassistant_settings_schema.lua:293
msgid "Emoji Data Access Indicators"
msgstr ""

#: koassistant_settings_schema.lua:296
msgid ""
"Show emoji indicators on action names showing what data they access: 📄 "
"document text, 🔖 highlights, 📝 annotations, 📓 notebook, 📚 library, 🌐 "
"web search. Requires emoji font support."
msgstr ""

#: koassistant_settings_schema.lua:303
msgid "Panel Alignment"
msgstr ""

#: koassistant_settings_schema.lua:308
msgid "Align Quick Settings"
msgstr ""

#: koassistant_settings_schema.lua:311
msgid ""
"Left-align button text in the Quick Settings panel instead of centering. "
"Also available from the panel's gear menu."
msgstr ""

#: koassistant_settings_schema.lua:316
msgid "Align Quick Actions"
msgstr ""

#: koassistant_settings_schema.lua:323
msgid ""
"Left-align button text in the Quick Actions panel instead of centering. Also "
"available from the panel's gear menu."
msgstr ""

#: koassistant_settings_schema.lua:330
msgid "Highlights"
msgstr ""

#: koassistant_settings_schema.lua:335
msgid "Hide Highlighted Text"
msgstr ""

#: koassistant_settings_schema.lua:342
msgid "Hide Long Highlights"
msgstr ""

#: koassistant_settings_schema.lua:350
msgid "Long Highlight Threshold"
msgstr ""

#: koassistant_settings_schema.lua:371
msgid ""
"How much of the screen chat, artifact, translate, dictionary and quiz "
"windows take. Expanded leaves only a hairline around them (and keeps "
"KOReader's status bar visible while a book is open), which fits more text "
"but leaves less room to tap outside. Also on each window's gear menu. "
"Compact dictionary popups are not affected."
msgstr ""

#: koassistant_settings_schema.lua:386
msgid "Plugin UI Language"
msgstr ""

#: koassistant_settings_schema.lua:389
msgid ""
"Language for plugin menus and dialogs. Does not affect AI responses. "
"Requires restart."
msgstr ""

#: koassistant_settings_schema.lua:391
msgid "Match KOReader"
msgstr ""

#: koassistant_settings_schema.lua:429
msgid "Please restart KOReader for the language change to take effect."
msgstr ""

#: koassistant_settings_schema.lua:440
msgid "Chat & Export Settings"
msgstr ""

#: koassistant_settings_schema.lua:446
msgid "Auto-save All Chats"
msgstr ""

#: koassistant_settings_schema.lua:453
msgid "Auto-save Continued Chats"
msgstr ""

#: koassistant_settings_schema.lua:463
msgid "Streaming"
msgstr ""

#: koassistant_settings_schema.lua:468 koassistant_settings_schema.lua:1541
#: koassistant_settings_schema.lua:1647
msgid "Enable Streaming"
msgstr ""

#: koassistant_settings_schema.lua:475
msgid "Auto-scroll Streaming"
msgstr ""

#: koassistant_settings_schema.lua:479
msgid ""
"Follow the arriving text while a response streams. Scrolling up pauses the "
"follow for that response so you can read in place while the rest arrives; "
"the Autoscroll button in the streaming window turns it back on."
msgstr ""

#: koassistant_settings_schema.lua:484
msgid "Keep Reading Position"
msgstr ""

#: koassistant_settings_schema.lua:488
msgid ""
"If auto-scroll is off or paused and you are reading while the response "
"streams, the finished chat opens where you were reading instead of at the "
"newest reply. In Markdown it opens on the page containing your spot; in "
"Plain Text your spot starts the view."
msgstr ""

#: koassistant_settings_schema.lua:493
msgid "Page-based Scroll (e-ink)"
msgstr ""

#: koassistant_settings_schema.lua:500
msgid ""
"Stream text into empty page space instead of scrolling from the bottom. "
"Reduces full-screen refreshes on e-ink. Disable for continuous bottom-"
"scrolling."
msgstr ""

#: koassistant_settings_schema.lua:505
msgid "Large Stream Dialog"
msgstr ""

#: koassistant_settings_schema.lua:513
msgid "Stream Poll Interval (ms)"
msgstr ""

#: koassistant_settings_schema.lua:520
msgid ""
"How often to check for new stream data.\n"
"Lower = snappier but uses more battery."
msgstr ""

#: koassistant_settings_schema.lua:526
msgid "Display Refresh Interval (ms)"
msgstr ""

#: koassistant_settings_schema.lua:533
msgid ""
"How often to refresh the display during streaming.\n"
"Higher = better performance on slower devices."
msgstr ""

#: koassistant_settings_schema.lua:545
msgid "Quick Answer Preset"
msgstr ""

#: koassistant_settings_schema.lua:550
msgid "Quick Answer On by Default"
msgstr ""

#: koassistant_settings_schema.lua:553
msgid ""
"Start new chats with the Quick Answer (⚡) button already on. You can still "
"turn it off per chat: and override the default per book from Book Settings "
"or the ⚡ button's menu."
msgstr ""

#: koassistant_settings_schema.lua:568
msgid ""
"How strongly Quick Answer asks for brevity: Standard requests a short, "
"direct reply (a few sentences, no preamble); Ultra-brief enforces a hard "
"ceiling (at most 3 short sentences, one plain paragraph, never restate the "
"question); Off sends no brevity instruction."
msgstr ""

#: koassistant_settings_schema.lua:575
msgid "Turn Reasoning Off"
msgstr ""

#: koassistant_settings_schema.lua:578
msgid ""
"Disable model reasoning/thinking for Quick Answer chats (models that can't "
"disable it drop to their lowest level). A one-shot reasoning pick in the "
"Quick chip's menu overrides this."
msgstr ""

#: koassistant_settings_schema.lua:583
msgid "Turn Web Search Off"
msgstr ""

#: koassistant_settings_schema.lua:590
msgid "Turn Book Tools Off"
msgstr ""

#: koassistant_settings_schema.lua:597
msgid "Skip Domain Lens"
msgstr ""

#: koassistant_settings_schema.lua:600
msgid ""
"Leave the selected domain lens out of Quick Answer chats. Off by default: "
"the domain shapes identity rather than length, and costs almost nothing in "
"speed."
msgstr ""

#: koassistant_settings_schema.lua:605
msgid "Skip Book Background"
msgstr ""

#: koassistant_settings_schema.lua:608
msgid ""
"Leave the per-book Background note out of Quick Answer chats. Off by "
"default: the Background frames how you read this book, and costs almost "
"nothing in speed."
msgstr ""

#: koassistant_settings_schema.lua:618
msgid ""
"Optionally change the AI behavior while Quick Answer is on: keep the current "
"one (default), swap to its Mini variant (same style family when one exists), "
"pin a specific behavior (the built-in Terse suits Quick Answer), or send "
"none at all. Actions that pin a behavior are unaffected."
msgstr ""

#: koassistant_settings_schema.lua:640
msgid "Model override: %1"
msgstr ""

#: koassistant_settings_schema.lua:642
msgid ""
"Optionally switch models while Quick Answer is on (that chat only: your "
"default model is untouched): the active provider's fastest listed model, a "
"tier of the active provider, or a pinned specific model. Custom providers "
"keep the current model unless custom_models.lua gives them tier placements. "
"A one-shot model pick in the Quick chip's menu overrides this."
msgstr ""

#: koassistant_settings_schema.lua:657
msgid ""
"On by default: the AI is told not to reveal events beyond your current "
"reading position in book and highlight chats, and X-Ray checkpoint updates "
"follow your position instead of installing the newest version. Research mode "
"disables protection. Override per book in Book Settings; per chat via the "
"Spoiler chip (chat input's gear menu → Toolbar Buttons). Custom actions can "
"use the {spoiler_free_nudge} placeholder."
msgstr ""

#: koassistant_settings_schema.lua:662
msgid "Book Info in Chat"
msgstr ""

#: koassistant_settings_schema.lua:671
msgid ""
"Default book context sent with freeform chats and book-aware actions "
"(Explain, etc.). 'None' sends no book line; 'Title only' omits the author; "
"'Title & author' is the default; 'Title, author & position' also adds "
"reading progress, chapter, and page (when basic stats are enabled). Override "
"per book in Book Settings. Actions that don't request book info (e.g. "
"Translate) are unaffected."
msgstr ""

#: koassistant_settings_schema.lua:678 koassistant_settings_schema.lua:1970
msgid "Content Format"
msgstr ""

#: koassistant_settings_schema.lua:683
msgid "Export Style"
msgstr ""

#: koassistant_settings_schema.lua:690
msgid ""
"Markdown uses # headers and **bold**. Plain text uses simple formatting."
msgstr ""

