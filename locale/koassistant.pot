#: koassistant/ui/prompts_manager.lua:2363
#: koassistant/ui/prompts_manager.lua:2420
msgid "Translate"
msgstr ""

#: koassistant/prompts/actions.lua:2647
msgid ""
"Translates the selected text into your configured translation language. This "
"action also controls the Translate Current Page function."
msgstr ""

#: koassistant/prompts/actions.lua:2667
msgid "Quick Define"
msgstr ""

#: koassistant/prompts/actions.lua:2668
msgid ""
"A brief, one-line dictionary definition of the selected word in your "
"dictionary language."
msgstr ""

#: koassistant/prompts/actions.lua:2700 koassistant/ui/chatgptviewer.lua:4721
#: koassistant/ui/prompts_manager.lua:2343
#: koassistant/ui/prompts_manager.lua:2361
#: koassistant/ui/prompts_manager.lua:2418
msgid "Dictionary"
msgstr ""

#: koassistant/prompts/actions.lua:2701
msgid ""
"Full dictionary entry with pronunciation, definitions, etymology, and "
"synonyms."
msgstr ""

#: koassistant/prompts/actions.lua:2734
msgid "Deep Analysis"
msgstr ""

#: koassistant/prompts/actions.lua:2735
msgid ""
"Deep linguistic analysis covering morphology, word family, etymology, "
"cognates, and cross-language borrowings. Adapts to the word's language "
"family (Semitic roots, Indo-European stems, etc.)."
msgstr ""

