msgstr ""

#: koassistant_settings_schema.lua:2147
msgid "Allow Basic Stats"
msgstr ""

#: koassistant_settings_schema.lua:2150
msgid ""
"Send reading progress (percentage), current chapter title, chapters read "
"count, and time since last opened. Used by X-Ray, Recap."
msgstr ""

#: koassistant_settings_schema.lua:2158
msgid ""
