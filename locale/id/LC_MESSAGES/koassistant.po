msgid "Image Generation"
msgstr "Pembuatan Gambar"

#: koassistant/ui/settings_schema.lua:3037
#, fuzzy
msgid "Generate images from highlighted text (button in the highlight menu)"
msgstr "Buat gambar dari teks yang disorot (tombol di menu sorotan)"

#: koassistant/ui/settings_schema.lua:3046
#: koassistant/ui/settings_schema.lua:3058
